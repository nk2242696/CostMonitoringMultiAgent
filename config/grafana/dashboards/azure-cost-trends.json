        {
          "datasource": {
            "type": "postgres",
            "uid": "PCC52D03280B7034C"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "\n                -- Historical monthly costs (last 12 months)\n                WITH historical_months AS (\n                    SELECT \n                        DATE_TRUNC('month', date) as month,\n                        SUM(cost) as total_cost\n                    FROM cost_records\n                    WHERE date >= DATE_TRUNC('month', CURRENT_DATE - INTERVAL '11 months')\n                      AND date < DATE_TRUNC('month', CURRENT_DATE + INTERVAL '1 month')\n                      AND subscription_id = '$subscription'\n                    GROUP BY DATE_TRUNC('month', date)\n                    ORDER BY month\n                ),\n                -- Calculate trend using linear regression\n                trend_calc AS (\n                    SELECT \n                        AVG(total_cost) as avg_cost,\n                        -- Better trend calculation: compare recent 3 months to previous 3 months\n                        CASE \n                            WHEN COUNT(*) >= 6 THEN\n                                (AVG(CASE WHEN month >= DATE_TRUNC('month', CURRENT_DATE - INTERVAL '2 months') THEN total_cost END) - \n                                 AVG(CASE WHEN month < DATE_TRUNC('month', CURRENT_DATE - INTERVAL '5 months') AND month >= DATE_TRUNC('month', CURRENT_DATE - INTERVAL '8 months') THEN total_cost END)) / 3\n                            ELSE 0\n                        END as monthly_change\n                    FROM historical_months\n                ),\n                -- Generate forecast for next 3 months\n                forecast_months AS (\n                    SELECT \n                        DATE_TRUNC('month', CURRENT_DATE + INTERVAL '1 month') + (n || ' months')::interval as month,\n                        GREATEST(0, (SELECT avg_cost + (monthly_change * (n + 1)) FROM trend_calc)) as total_cost\n                    FROM generate_series(0, 2) as n\n                )\n                -- Combine historical and forecast\n                SELECT month as time, total_cost as \"Historical\"\n                FROM historical_months\n                UNION ALL\n                SELECT month as time, total_cost as \"Forecast\"\n                FROM forecast_months\n                ORDER BY time;\n            "
        }
      ],
      "title": "Multi-Month Cost Forecast",
      "type": "timeseries"
    },
