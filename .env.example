# Azure Cost Monitoring System - Environment Configuration
# Copy this file to .env and fill in your values

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
DATABASE_URL=sqlite+aiosqlite:///cost_monitoring.db
# For PostgreSQL with Docker:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/azure_cost_dev

# ============================================================================
# AZURE SUBSCRIPTION & AUTHENTICATION (For Azure Advisor API)
# ============================================================================
# Required for Azure Advisor, Resource Graph, and Cost Management APIs
AZURE_SUBSCRIPTION_ID=your-subscription-id-here
AZURE_TENANT_ID=your-tenant-id-here

# Optional: Service Principal Authentication (if not using Azure CLI)
# AZURE_CLIENT_ID=your-client-id-here
# AZURE_CLIENT_SECRET=your-client-secret-here

# ============================================================================
# AZURE OPENAI (Optional - for AI-powered recommendations)
# ============================================================================
AZURE_OPENAI_ENDPOINT=https://your-openai-resource.openai.azure.com/
AZURE_OPENAI_KEY=your-openai-api-key-here
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# ============================================================================
# DATABRICKS (for Tier 3 Spark/Databricks job analysis)
# ============================================================================
DATABRICKS_HOST=https://adb-xxxx.azuredatabricks.net
DATABRICKS_TOKEN=dapi-your-token-here

# ============================================================================
# API SERVER CONFIGURATION
# ============================================================================
PORT=8000
HOST=0.0.0.0

# ============================================================================
# PROMETHEUS & MONITORING
# ============================================================================
PROMETHEUS_PORT=8001
METRICS_EXPORT_INTERVAL=60

# ============================================================================
# GRAFANA CONFIGURATION
# ============================================================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ============================================================================
# AUTHENTICATION & SETUP INSTRUCTIONS
# ============================================================================
#
# To use Azure Advisor API and other Azure services:
#
# Option 1: Azure CLI Authentication (Recommended for Development)
# ------------------------------------------------------------------
# 1. Install Azure CLI: https://docs.microsoft.com/en-us/cli/azure/install-azure-cli
# 2. Login: az login
# 3. Set subscription: az account set --subscription "your-subscription-id"
# 4. Set AZURE_SUBSCRIPTION_ID above
#
# Option 2: Service Principal (Recommended for Production)
# ---------------------------------------------------------
# 1. Create Service Principal:
#    az ad sp create-for-rbac --name "CostMonitoringSP" --role "Reader" --scopes /subscriptions/{subscription-id}
# 
# 2. Note the output:
#    - appId -> AZURE_CLIENT_ID
#    - password -> AZURE_CLIENT_SECRET
#    - tenant -> AZURE_TENANT_ID
#
# 3. Set all AZURE_* variables above
#
# Required Azure Permissions:
# - Reader role on subscription (for Advisor, Resource Graph)
# - Cost Management Reader (for Cost Management APIs)
#
# To get your subscription ID:
# az account show --query id --output tsv
#
# ============================================================================
