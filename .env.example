# Copy to .env and replace every value marked CHANGE_ME.

# Database and application security
POSTGRES_DB=azure_cost
POSTGRES_USER=cost_monitor
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD
SECRET_KEY=CHANGE_ME_USE_AT_LEAST_32_RANDOM_CHARACTERS
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_USE_A_DIFFERENT_RANDOM_PASSWORD

# Published ports
API_PORT=8000
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090

# Azure authentication. Leave client credentials empty when using managed identity.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Comma-separated subscription IDs; blank discovers all accessible subscriptions.
AZURE_SUBSCRIPTION_IDS=

# AI: disabled | azure_openai | openai_compatible
LLM_PROVIDER=disabled
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o
LLM_API_VERSION=2024-12-01-preview
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# Multi-agent runtime (disabled by default during staged rollout)
AGENT_RUNTIME_ENABLED=false
AGENT_CHAT_MODEL=
AGENT_BACKGROUND_MODEL=
AGENT_NODE_TIMEOUT_SECONDS=60
AGENT_WORKFLOW_TIMEOUT_SECONDS=180
AGENT_MAX_REFINEMENT_ROUNDS=2
AGENT_MAX_TOOL_CALLS=8
AGENT_MAX_MODEL_CALLS=12
AGENT_CHECKPOINT_RETENTION_DAYS=30
AGENT_BACKGROUND_SCHEDULE=0 0 * * 0

# Optional Databricks/Spark analysis
DATABRICKS_HOST=
DATABRICKS_TOKEN=
