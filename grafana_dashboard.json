{
  "dashboard": {
    "id": null,
    "title": "Azure Cost Monitoring - Fixed",
    "tags": ["azure", "cost", "monitoring"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Cost by Service",
        "type": "piechart",
        "targets": [
          {
            "format": "table",
            "group": [],
            "metricColumn": "none",
            "rawQuery": true,
            "rawSql": "SELECT service_name as metric, SUM(cost) as value FROM cost_records GROUP BY service_name ORDER BY value DESC",
            "refId": "A",
            "select": [
              [
                {
                  "params": ["cost"],
                  "type": "column"
                }
              ]
            ],
            "table": "cost_records",
            "timeColumn": "date",
            "timeColumnType": "date",
            "where": [
              {
                "name": "$__timeFilter",
                "params": [],
                "type": "macro"
              }
            ]
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 0
        },
        "options": {
          "pieType": "pie",
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": ""
          },
          "tooltip": {
            "mode": "single"
          },
          "legend": {
            "displayMode": "table",
            "placement": "right",
            "values": ["value"]
          }
        }
      },
      {
        "id": 2,
        "title": "Top Services by Cost",
        "type": "barchart",
        "targets": [
          {
            "format": "table",
            "group": [],
            "metricColumn": "none",
            "rawQuery": true,
            "rawSql": "SELECT service_name, SUM(cost) as total_cost FROM cost_records GROUP BY service_name ORDER BY total_cost DESC LIMIT 10",
            "refId": "A"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 0
        }
      },
      {
        "id": 3,
        "title": "Daily Cost Trend",
        "type": "timeseries",
        "targets": [
          {
            "format": "time_series",
            "group": [],
            "metricColumn": "none",
            "rawQuery": true,
            "rawSql": "SELECT date as time, SUM(cost) as value FROM cost_records WHERE $__timeFilter(date) GROUP BY date ORDER BY date",
            "refId": "A"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 24,
          "x": 0,
          "y": 8
        }
      },
      {
        "id": 4,
        "title": "AI Recommendations Summary",
        "type": "stat",
        "targets": [
          {
            "format": "table",
            "group": [],
            "metricColumn": "none",
            "rawQuery": true,
            "rawSql": "SELECT COUNT(*) as recommendations, SUM(potential_savings) as total_savings FROM ai_recommendations",
            "refId": "A"
          }
        ],
        "gridPos": {
          "h": 4,
          "w": 12,
          "x": 0,
          "y": 16
        }
      }
    ],
    "time": {
      "from": "now-30d",
      "to": "now"
    },
    "timepicker": {},
    "templating": {
      "list": []
    },
    "annotations": {
      "list": []
    },
    "refresh": "5m",
    "version": 1,
    "editable": true
  },
  "overwrite": true
}